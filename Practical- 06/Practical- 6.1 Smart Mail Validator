<script>


/* =========================================================
   DATE DROPDOWNS
========================================================= */

const daySelect =
    document.getElementById("dobDay");

const yearSelect =
    document.getElementById("dobYear");


for(let i = 1; i <= 31; i++) {

    const option =
        document.createElement("option");

    option.value = i;

    option.textContent = i;

    daySelect.appendChild(option);
}


const currentYear =
    new Date().getFullYear();


for(
    let i = currentYear;
    i >= 1950;
    i--
) {

    const option =
        document.createElement("option");

    option.value = i;

    option.textContent = i;

    yearSelect.appendChild(option);
}



/* =========================================================
   EMAIL REGEX
========================================================= */

const emailRegex =
    /^[^\s@]+@[^\s@]+\.[^\s@]+$/;



/* =========================================================
   EMAIL VALIDATION
========================================================= */

function validateEmail(email) {

    /*
        STRING FUNCTION:
        trim()
    */

    email =
        email.trim();


    if(email.length === 0) {

        return {

            valid: false,

            message:
                "Email address cannot be empty.",

            details: [
                "Please enter your email address."
            ]

        };
    }


    /*
        STRING FUNCTION:
        includes()
    */

    if(email.includes(" ")) {

        return {

            valid: false,

            message:
                "Email address contains spaces.",

            details: [
                "Remove spaces from your email address."
            ]

        };
    }


    if(!email.includes("@")) {

        return {

            valid: false,

            message:
                "Email address is missing @.",

            details: [
                "Your email must contain the @ symbol."
            ]

        };
    }


    /*
        STRING FUNCTION:
        split()
    */

    const parts =
        email.split("@");


    if(parts[0].length === 0) {

        return {

            valid: false,

            message:
                "Email username is missing.",

            details: [
                "Enter a username before @."
            ]

        };
    }


    if(
        parts.length !== 2 ||
        parts[1].length === 0
    ) {

        return {

            valid: false,

            message:
                "Email domain is missing.",

            details: [
                "Enter a domain after @."
            ]

        };
    }


    if(!parts[1].includes(".")) {

        return {

            valid: false,

            message:
                "Email extension is missing.",

            details: [
                "Example: student@gmail.com"
            ]

        };
    }


    /*
        REGEX VALIDATION
    */

    if(!emailRegex.test(email)) {

        return {

            valid: false,

            message:
                "Invalid email format.",

            details: [
                "Please enter a valid email address.",
                "Example: student@gmail.com"
            ]

        };
    }


    return {

        valid: true,

        message:
            "Valid email address.",

        details: []

    };
}



/* =========================================================
   PASSWORD VALIDATION
========================================================= */

function checkPassword(
    password,
    prefix
) {

    const lengthValid =
        password.length >= 8;

    const upperValid =
        /[A-Z]/.test(password);

    const lowerValid =
        /[a-z]/.test(password);

    const numberValid =
        /[0-9]/.test(password);

    const specialValid =
        /[^A-Za-z0-9]/.test(password);


    updateCondition(
        prefix + "Length",
        lengthValid,
        "At least 8 characters"
    );

    updateCondition(
        prefix + "Upper",
        upperValid,
        "At least one uppercase letter"
    );

    updateCondition(
        prefix + "Lower",
        lowerValid,
        "At least one lowercase letter"
    );

    updateCondition(
        prefix + "Number",
        numberValid,
        "At least one number"
    );

    updateCondition(
        prefix + "Special",
        specialValid,
        "At least one special character"
    );


    return (
        lengthValid &&
        upperValid &&
        lowerValid &&
        numberValid &&
        specialValid
    );
}



/* =========================================================
   UPDATE CONDITION
========================================================= */

function updateCondition(
    id,
    valid,
    text
) {

    const element =
        document.getElementById(id);


    if(valid) {

        element.className =
            "condition valid";

        element.textContent =
            "✓ " + text;

    } else {

        element.className =
            "condition invalid";

        element.textContent =
            "✗ " + text;
    }
}



/* =========================================================
   LIVE PASSWORD VALIDATION
========================================================= */

document
.getElementById("loginPassword")
.addEventListener(
    "input",
    function() {

        checkPassword(
            this.value,
