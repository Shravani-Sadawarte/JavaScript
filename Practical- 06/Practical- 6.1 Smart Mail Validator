.footer strong {

    color:
        #4c555d;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    body {

        align-items:
            flex-start;

        padding-top:
            25px;
    }

    .container {

        padding:
            15px;
    }

    .card {

        padding:
            25px 21px;

        border-radius:
            23px;
    }

    .floating-mail {

        display:
            none;
    }

    .name-row {

        grid-template-columns:
            1fr;
    }

    h1 {

        font-size:
            24px;
    }
}

</style>
</head>


