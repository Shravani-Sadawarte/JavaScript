<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SmartMail Validator</title>

<style>

/* =========================================================
   GLOBAL
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;

    background:
        linear-gradient(
            135deg,
            #dff3ff 0%,
            #eaf7ff 30%,
            #f0eaff 65%,
            #e7fff0 100%
        );

    display: flex;
    justify-content: center;
    align-items: center;

    overflow-x: hidden;

    color: #202124;
}


/* =========================================================
   BACKGROUND DECORATIONS
========================================================= */

.background {
    position: fixed;
    inset: 0;

    overflow: hidden;

    pointer-events: none;

    z-index: -1;
}

.blob {
    position: absolute;

    border-radius: 50%;

    filter: blur(2px);

    opacity: 0.9;
}

.blob.one {
    width: 420px;
    height: 420px;

    background: #4285f4;

    left: -170px;
    top: -130px;
}

.blob.two {
    width: 380px;
    height: 380px;

    background: #34a853;

    right: -150px;
    bottom: -120px;
}

.blob.three {
    width: 300px;
    height: 300px;

    background: #fbbc04;

    right: -100px;
    top: 60px;

    opacity: 0.65;
}

.blob.four {
    width: 330px;
    height: 330px;

    background: #ea4335;

    left: -120px;
    bottom: 20px;

    opacity: 0.55;
}


/* =========================================================
   DECORATIVE MAIL ICONS
========================================================= */

.floating-mail {
    position: absolute;

    width: 85px;
    height: 85px;

    background: rgba(255,255,255,0.65);

    backdrop-filter: blur(10px);

    border-radius: 50%;

    display: flex;

    justify-content: center;
    align-items: center;

    font-size: 38px;

    box-shadow:
        0 15px 35px rgba(0,0,0,0.12);

    animation: float 5s ease-in-out infinite;
}

.mail-one {
    top: 9%;
    left: 10%;
}

.mail-two {
    right: 9%;
    top: 18%;

    animation-delay: 1s;
}

.mail-three {
    left: 8%;
    bottom: 13%;

    animation-delay: 2s;
}

.mail-four {
    right: 12%;
    bottom: 9%;

    animation-delay: 3s;
}

@keyframes float {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.container {
    width: 100%;
    max-width: 470px;

    padding: 25px 15px;
}


/* =========================================================
   AUTH CARD
========================================================= */

.card {

    background:
        rgba(255,255,255,0.91);

    backdrop-filter:
        blur(18px);

    -webkit-backdrop-filter:
        blur(18px);

    border:
        1px solid rgba(255,255,255,0.9);

    border-radius: 28px;

    padding: 34px;

    box-shadow:
        0 25px 70px rgba(31, 50, 80, 0.20);

    animation:
        cardAppear 0.5s ease;
}

@keyframes cardAppear {

    from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* =========================================================
   LOGO
========================================================= */

.logo-wrapper {

    display: flex;

    justify-content: center;

    margin-bottom: 15px;
}

.mail-logo {

    width: 65px;
    height: 65px;

    border-radius: 18px;

    background:
        linear-gradient(
            135deg,
            #4285f4,
            #34a853
        );

    position: relative;

    display: flex;

    justify-content: center;

    align-items: center;

    box-shadow:
        0 10px 25px rgba(66,133,244,0.25);
}


/* Mail M */

.mail-logo::before {

    content: "";

    width: 34px;
    height: 25px;

    border:
        4px solid white;

    border-top:
        0;

    border-radius:
        0 0 5px 5px;

    position: absolute;

    bottom: 17px;
}


/* Mail diagonal */

.mail-logo::after {

    content: "";

    width: 27px;
    height: 27px;

    border-left:
        4px solid white;

    border-bottom:
        4px solid white;

    transform:
        rotate(-45deg);

    position: absolute;

    top: 13px;
}


/* =========================================================
   TITLES
========================================================= */

h1 {

    text-align: center;

    font-size: 27px;

    margin-bottom: 8px;

    color: #202124;
}

.subtitle {

    text-align: center;

    color: #687078;

    font-size: 14px;

    line-height: 1.6;

    margin-bottom: 28px;
}


/* =========================================================
   SECTION LABEL
========================================================= */

.section-label {

    font-size: 13px;

    color: #5f6368;

    text-transform: uppercase;

    letter-spacing: 0.7px;

    font-weight: bold;

    margin-bottom: 8px;
}


/* =========================================================
   FORM FIELD
========================================================= */

.field {

    margin-bottom: 19px;
}

label {

    display: block;

    font-size: 15px;

    font-weight: 600;

    margin-bottom: 8px;

    color: #30343b;
}


/* =========================================================
   INPUTS
========================================================= */

input,
select {

    width: 100%;

    height: 53px;

    border-radius: 14px;

    border:
        1.5px solid #c4cbd3;

    background:
        rgba(255,255,255,0.85);

    padding:
        0 16px;

    font-size: 16px;

    outline: none;

    transition:
        0.2s ease;
}

input::placeholder {

    color: #8b9299;
}

input:hover,
select:hover {

    border-color:
        #9ba8b5;
}

input:focus,
select:focus {

    border-color:
        #4285f4;

    background:
        white;

    box-shadow:
        0 0 0 4px
        rgba(66,133,244,0.12);
}


/* =========================================================
   PASSWORD WRAPPER
========================================================= */

.password-wrapper {

    position: relative;
}

.password-wrapper input {

    padding-right: 70px;
}

.show-password {

    position: absolute;

    right: 15px;

    top: 50%;

    transform:
        translateY(-50%);

    border: none;

    background: transparent;

    color: #1a73e8;

    font-size: 13px;

    font-weight: bold;

    cursor: pointer;
}


/* =========================================================
   PASSWORD REQUIREMENTS
========================================================= */

.validation-box {

    margin-top: 12px;

    padding: 16px;

    border-radius: 15px;

    background:
        rgba(245,247,250,0.9);

    border:
        1px solid #dce1e6;
}

.validation-title {

    font-size: 14px;

    font-weight: bold;

    margin-bottom: 10px;

    color: #34373c;
}

.condition {

    font-size: 13px;

    margin: 7px 0;

    transition:
        0.2s;
}

.valid {

    color: #188038;
}

.invalid {

    color: #d93025;
}


/* =========================================================
   BUTTON
========================================================= */

.btn {

    width: 100%;

    height: 52px;

    border: none;

    border-radius: 26px;

    background:
        linear-gradient(
            90deg,
            #1a73e8,
            #4285f4
        );

    color: white;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 8px 18px
        rgba(26,115,232,0.25);

    transition:
        0.2s ease;
}

.btn:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 12px 24px
        rgba(26,115,232,0.32);
}

.btn:active {

    transform:
        translateY(0);
}


/* =========================================================
   SECONDARY BUTTON
========================================================= */

.secondary-btn {

    width: 100%;

    height: 50px;

    border-radius: 25px;

    border:
        1.5px solid #1a73e8;

    background:
        rgba(255,255,255,0.8);

    color:
        #1a73e8;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;

    transition:
        0.2s;
}

.secondary-btn:hover {

    background:
        #eef5ff;
}


/* =========================================================
   DIVIDER
========================================================= */

.divider {

    display: flex;

    align-items: center;

    gap: 12px;

    margin: 22px 0;

    color: #8a9198;

    font-size: 12px;

    font-weight: bold;
}

.divider::before,
.divider::after {

    content: "";

    height: 1px;

    background: #d8dde2;

    flex: 1;
}


/* =========================================================
   ERROR NOTIFICATION
========================================================= */

.field-error {

    display: none;

    margin-top: 8px;

    padding: 11px 13px;

    border-radius: 11px;

    background:
        #fff1f1;

    border:
        1px solid #ffb8b8;

    color:
        #d93025;

    font-size: 13px;

    line-height: 1.55;
}


/* =========================================================
   SUCCESS TEXT
========================================================= */

.success-text {

    display: none;

    color:
        #188038;

    font-size: 12px;

    margin-top: 6px;
}


/* =========================================================
   RESULT
========================================================= */

.result {

    display: none;

    margin-top: 16px;

    padding: 15px;

    border-radius: 14px;

    text-align: center;

    font-size: 14px;

    line-height: 1.6;

    font-weight: 600;
}

.result.success {

    display: block;

    background:
        #eaf7ee;

    border:
        1px solid #a8d8b7;

    color:
        #188038;
}

.result.error {

    display: block;

    background:
        #fff0f0;

    border:
        1px solid #ffb3b3;

    color:
        #d93025;
}


/* =========================================================
   REGISTER NAME
========================================================= */

.name-row {

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap: 12px;
}


/* =========================================================
   DOB
========================================================= */

.dob-row {

    display:
        grid;

    grid-template-columns:
        1fr 1fr 1fr;

    gap: 9px;
}


/* =========================================================
   BACK LOGIN
========================================================= */

.back-login {

    text-align:
        center;

    margin-top:
        20px;

    color:
        #1a73e8;

    font-size:
        14px;

    font-weight:
        600;

    cursor:
        pointer;
}

.back-login:hover {

    text-decoration:
        underline;
}


/* =========================================================
   INFO TEXT
========================================================= */

.info-text {

    color:
        #737980;

    font-size:
        12px;

    margin-top:
        6px;
}


/* =========================================================
   SUCCESS SCREEN
========================================================= */

.account-created {

    text-align:
        center;

    padding:
        15px 5px;
}

.success-icon {

    width:
        75px;

    height:
        75px;

    border-radius:
        50%;

    background:
        #e6f6eb;

    color:
        #188038;

    font-size:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    margin:
        0 auto 18px;
}

.account-created h2 {

    font-size:
        25px;

    color:
        #188038;

    margin-bottom:
        10px;
}

.account-created p {

    color:
        #6b737a;

    line-height:
        1.6;

    margin-bottom:
        22px;
}


/* =========================================================
   HIDDEN
========================================================= */

.hidden {

    display:
        none !important;
}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    text-align:
        center;

    margin-top:
        18px;

    color:
        #687078;

    font-size:
        11px;
