        );

    }
);



/* =========================================================
   LOGIN VALIDATION
========================================================= */

function validateLogin() {

    const email =
        document
        .getElementById("loginEmail")
        .value;


    const password =
        document
        .getElementById("loginPassword")
        .value;


    const emailResult =
        validateEmail(email);


    const emailError =
        document.getElementById(
            "loginEmailError"
        );


    const emailSuccess =
        document.getElementById(
            "loginEmailSuccess"
        );


    if(emailResult.valid) {

        emailError.style.display =
            "none";

        emailSuccess.style.display =
            "block";

    } else {

        emailSuccess.style.display =
            "none";

        emailError.style.display =
            "block";


        emailError.innerHTML =
            "✗ <strong>" +
            emailResult.message +
            "</strong><br>" +

            emailResult.details
            .map(
                item => "• " + item
            )
            .join("<br>");
    }


    const passwordValid =
        checkPassword(
            password,
            "login"
        );


    const result =
        document.getElementById(
            "loginResult"
        );


    if(
        emailResult.valid &&
        passwordValid
    ) {

        result.className =
            "result success";

        result.innerHTML =
            "✓ Login validation successful!<br>" +
            "Email and password satisfy all conditions.";

    } else {

        result.className =
            "result error";

        result.innerHTML =
            "✗ Login validation failed.<br>" +
            "Please correct the conditions marked above.";
    }
}



/* =========================================================
   CREATE ACCOUNT
========================================================= */

function createAccount() {

    let valid = true;


    const firstName =
        document
        .getElementById("firstName")
        .value
        .trim();


    const surname =
        document
        .getElementById("surname")
        .value
        .trim();


    const dobDay =
        document
        .getElementById("dobDay")
        .value;


    const dobMonth =
        document
        .getElementById("dobMonth")
        .value;


    const dobYear =
        document
        .getElementById("dobYear")
        .value;


    const gender =
        document
        .getElementById("gender")
        .value;


    const email =
        document
        .getElementById("registerEmail")
        .value;


    const mobile =
        document
        .getElementById("mobile")
        .value
        .trim();


    const password =
        document
        .getElementById("registerPassword")
        .value;


    const confirmPassword =
        document
        .getElementById("confirmPassword")
        .value;



    /* NAME */

    const nameError =
        document.getElementById(
            "nameError"
        );


    const nameRegex =
        /^[A-Za-z ]+$/;


    if(
        firstName.length === 0 ||
        surname.length === 0
    ) {

        nameError.style.display =
            "block";

        nameError.textContent =
            "✗ First name and surname are required.";

        valid = false;

    } else if(
        !nameRegex.test(firstName) ||
        !nameRegex.test(surname)
    ) {

        nameError.style.display =
            "block";

        nameError.textContent =
            "✗ Name should contain letters only.";

        valid = false;

    } else {

        nameError.style.display =
            "none";
    }



    /* DOB */

    const dobError =
        document.getElementById(
            "dobError"
        );


    if(
        dobDay === "" ||
        dobMonth === "" ||
        dobYear === ""
    ) {

        dobError.style.display =
            "block";

        dobError.textContent =
            "✗ Please select your complete date of birth.";

        valid = false;

    } else {

        dobError.style.display =
            "none";
    }



    /* GENDER */

    const genderError =
        document.getElementById(
            "genderError"
        );


    if(gender === "") {

        genderError.style.display =
            "block";

        genderError.textContent =
            "✗ Please select your gender.";

        valid = false;

    } else {

        genderError.style.display =
            "none";
    }



    /* EMAIL */

    const emailResult =
        validateEmail(email);


    const emailError =
        document.getElementById(
            "registerEmailError"
        );


    if(!emailResult.valid) {

        emailError.style.display =
            "block";

        emailError.innerHTML =
            "✗ <strong>" +
            emailResult.message +
            "</strong><br>" +

            emailResult.details
            .map(
                item => "• " + item
            )
            .join("<br>");

        valid = false;

    } else {

        emailError.style.display =
            "none";
    }



    /* MOBILE */

    const mobileError =
        document.getElementById(
            "mobileError"
        );


    const mobileRegex =
        /^[0-9]{10}$/;


    if(!mobileRegex.test(mobile)) {

        mobileError.style.display =
            "block";

        mobileError.textContent =
            "✗ Mobile number must contain exactly 10 digits.";

        valid = false;

    } else {

        mobileError.style.display =
            "none";
    }



    /* PASSWORD */

    const passwordValid =
        checkPassword(
            password,
            "reg"
        );


    if(!passwordValid) {

        valid = false;
    }



    /* CONFIRM PASSWORD */

    const confirmError =
        document.getElementById(
            "confirmError"
        );


    const confirmSuccess =
        document.getElementById(
            "confirmSuccess"
        );


    if(
        confirmPassword.length === 0 ||
        password !== confirmPassword
    ) {

        confirmError.style.display =
            "block";

        confirmSuccess.style.display =
            "none";

        confirmError.textContent =
            "✗ Passwords do not match.";

        valid = false;

    } else {

        confirmError.style.display =
            "none";

        confirmSuccess.style.display =
            "block";
    }



    /* FINAL */

    const result =
        document.getElementById(
            "registerResult"
        );


    if(valid) {

        document
        .getElementById("registerCard")
        .classList.add("hidden");


        document
        .getElementById("successCard")
        .classList.remove("hidden");

    } else {

        result.className =
            "result error";

        result.innerHTML =
            "✗ Account cannot be created yet.<br>" +
            "Please correct the highlighted conditions.";
    }
}



